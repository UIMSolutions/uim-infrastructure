module uim.infrastructure.sdk_ai.infrastructure.http.views.dashboard_view;

string renderDashboardPage(string provider, string tenantId) {
    return "<!doctype html>"
        ~ "<html lang='en'>"
        ~ "<head>"
        ~ "<meta charset='utf-8'>"
        ~ "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        ~ "<title>UIM SDK AI</title>"
        ~ "<style>"
        ~ ":root{--bg:#f4f0e8;--panel:#fffaf1;--ink:#17202a;--muted:#5e6c78;--brand:#0d6a8a;--accent:#d86b1f;--line:#dbcdb8;}"
        ~ "*{box-sizing:border-box}"
        ~ "body{margin:0;font-family:'IBM Plex Sans',sans-serif;background:radial-gradient(circle at 20% 10%,#fff3de 0,#f4f0e8 40%,#ece2d5 100%);color:var(--ink)}"
        ~ ".wrap{max-width:980px;margin:0 auto;padding:24px}"
        ~ ".hero{background:linear-gradient(135deg,#fff,#f7f1e7);border:1px solid var(--line);border-radius:18px;padding:20px 24px;box-shadow:0 8px 30px rgba(23,32,42,.08)}"
        ~ "h1{margin:0 0 8px;font-size:2rem;letter-spacing:.02em}"
        ~ "p{margin:0;color:var(--muted)}"
        ~ ".grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:18px}"
        ~ "@media (min-width:900px){.grid{grid-template-columns:1fr 1fr}}"
        ~ ".card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}"
        ~ "label{display:block;font-weight:600;margin:10px 0 6px}"
        ~ "input,textarea{width:100%;border:1px solid #c2b39f;border-radius:10px;padding:10px;font:inherit;background:#fff}"
        ~ "textarea{min-height:120px;resize:vertical}"
        ~ "button{margin-top:12px;border:0;border-radius:10px;padding:11px 14px;font-weight:700;background:var(--brand);color:#fff;cursor:pointer}"
        ~ "button:hover{background:#0a5771}"
        ~ ".hint{font-size:.9rem;color:var(--muted)}"
        ~ "pre{white-space:pre-wrap;background:#fff;border:1px solid #d8c9b4;border-radius:10px;padding:12px;min-height:108px}"
        ~ "code{font-family:'IBM Plex Mono',monospace}"
        ~ "</style>"
        ~ "</head>"
        ~ "<body>"
        ~ "<div class='wrap'>"
        ~ "<section class='hero'>"
        ~ "<h1>UIM SDK AI Service</h1>"
        ~ "<p>Provider: <strong>" ~ provider ~ "</strong> | Default Tenant: <strong>" ~ tenantId ~ "</strong></p>"
        ~ "</section>"
        ~ "<section class='grid'>"
        ~ "<article class='card'>"
        ~ "<h2>Model Catalog</h2>"
        ~ "<p class='hint'>Lists models from API endpoint <code>/api/v1/models</code>.</p>"
        ~ "<label for='tenant'>Tenant ID</label>"
        ~ "<input id='tenant' value='" ~ tenantId ~ "'>"
        ~ "<button type='button' onclick='loadModels()'>Load Models</button>"
        ~ "<pre id='models'></pre>"
        ~ "</article>"
        ~ "<article class='card'>"
        ~ "<h2>Chat Completion</h2>"
        ~ "<p class='hint'>Calls <code>/api/v1/chat/completions</code> and renders assistant output.</p>"
        ~ "<label for='model'>Model</label>"
        ~ "<input id='model' value='gpt-4o-mini'>"
        ~ "<label for='prompt'>Prompt</label>"
        ~ "<textarea id='prompt'>Create a short architecture summary for a clean hexagonal AI SDK service.</textarea>"
        ~ "<button type='button' onclick='runChat()'>Run Chat Completion</button>"
        ~ "<pre id='chat'></pre>"
        ~ "</article>"
        ~ "</section>"
        ~ "</div>"
        ~ "<script>"
        ~ "async function loadModels(){"
        ~ "const t=document.getElementById('tenant').value||'default';"
        ~ "const r=await fetch('/api/v1/models?tenantId='+encodeURIComponent(t));"
        ~ "document.getElementById('models').textContent=JSON.stringify(await r.json(),null,2);"
        ~ "}"
        ~ "async function runChat(){"
        ~ "const t=document.getElementById('tenant').value||'default';"
        ~ "const m=document.getElementById('model').value||'gpt-4o-mini';"
        ~ "const p=document.getElementById('prompt').value||'Hello';"
        ~ "const payload={tenantId:t,model:m,temperature:0.2,max_tokens:512,messages:[{role:'user',content:p}]};"
        ~ "const r=await fetch('/api/v1/chat/completions',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});"
        ~ "document.getElementById('chat').textContent=JSON.stringify(await r.json(),null,2);"
        ~ "}"
        ~ "loadModels();"
        ~ "</script>"
        ~ "</body>"
        ~ "</html>";
}
