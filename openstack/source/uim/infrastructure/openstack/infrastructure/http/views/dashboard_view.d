module uim.infrastructure.openstack.infrastructure.http.views.dashboard_view;

string renderDashboardPage(string defaultRegion) {
    return "<!doctype html>"
        ~ "<html lang='en'>"
        ~ "<head>"
        ~ "<meta charset='utf-8'>"
        ~ "<meta name='viewport' content='width=device-width, initial-scale=1'>"
        ~ "<title>UIM OpenStack Service</title>"
        ~ "<style>"
        ~ ":root{--bg:#eef3f8;--panel:#ffffff;--ink:#1d2733;--muted:#5c6a77;--brand:#005f99;--line:#d3dde7;--accent:#dd6d00;}"
        ~ "*{box-sizing:border-box}"
        ~ "body{margin:0;background:linear-gradient(160deg,#eff6ff 0%,#edf2f7 45%,#e5edf5 100%);font-family:'Source Sans Pro',sans-serif;color:var(--ink)}"
        ~ ".container{max-width:1040px;margin:0 auto;padding:24px}"
        ~ ".hero{background:var(--panel);border:1px solid var(--line);border-radius:16px;padding:20px;box-shadow:0 10px 22px rgba(0,40,80,.07)}"
        ~ "h1{margin:0 0 8px;font-size:2rem}"
        ~ "p{margin:0;color:var(--muted)}"
        ~ ".grid{display:grid;grid-template-columns:1fr;gap:16px;margin-top:18px}"
        ~ "@media (min-width:900px){.grid{grid-template-columns:1fr 1fr}}"
        ~ ".card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px}"
        ~ "label{display:block;margin:10px 0 6px;font-weight:700}"
        ~ "input,select{width:100%;padding:10px;border-radius:10px;border:1px solid #b7c6d6;background:#fff}"
        ~ "button{margin-top:12px;padding:10px 14px;border:0;border-radius:10px;background:var(--brand);color:#fff;font-weight:700;cursor:pointer}"
        ~ "button:hover{background:#004d7d}"
        ~ "pre{min-height:140px;background:#f8fbff;border:1px solid #d5e1ee;border-radius:10px;padding:10px;white-space:pre-wrap}"
        ~ "small{color:var(--muted)}"
        ~ "</style>"
        ~ "</head>"
        ~ "<body>"
        ~ "<div class='container'>"
        ~ "<section class='hero'>"
        ~ "<h1>OpenStack Operations Console</h1>"
        ~ "<p>Explore projects, list servers, and trigger reboot via Clean + Hexagonal service APIs.</p>"
        ~ "</section>"
        ~ "<section class='grid'>"
        ~ "<article class='card'>"
        ~ "<h2>Project and Server Inventory</h2>"
        ~ "<label for='token'>X-Auth-Token</label>"
        ~ "<input id='token' placeholder='optional for local fallback mode'>"
        ~ "<label for='region'>Region</label>"
        ~ "<input id='region' value='" ~ defaultRegion ~ "'>"
        ~ "<button onclick='loadInventory()'>Load Inventory</button>"
        ~ "<pre id='inventory'></pre>"
        ~ "</article>"
        ~ "<article class='card'>"
        ~ "<h2>Server Action</h2>"
        ~ "<label for='serverId'>Server ID</label>"
        ~ "<input id='serverId' value='server-1'>"
        ~ "<label for='rebootType'>Reboot Type</label>"
        ~ "<select id='rebootType'><option>SOFT</option><option>HARD</option></select>"
        ~ "<button onclick='rebootServer()'>Reboot Server</button>"
        ~ "<pre id='action'></pre>"
        ~ "<small>Endpoint: /api/v1/server-actions</small>"
        ~ "</article>"
        ~ "</section>"
        ~ "</div>"
        ~ "<script>"
        ~ "function authHeaders(){const t=document.getElementById('token').value.trim();return t?{'X-Auth-Token':t}:{}}"
        ~ "async function loadInventory(){"
        ~ "const region=document.getElementById('region').value||'RegionOne';"
        ~ "const p=await fetch('/api/v1/projects',{headers:authHeaders()});"
        ~ "const projects=await p.json();"
        ~ "let servers={data:[]};"
        ~ "if(projects.data&&projects.data.length){const pid=projects.data[0].id;const s=await fetch('/api/v1/servers?projectId='+encodeURIComponent(pid)+'&region='+encodeURIComponent(region),{headers:authHeaders()});servers=await s.json();}"
        ~ "document.getElementById('inventory').textContent=JSON.stringify({projects,servers},null,2);"
        ~ "}"
        ~ "async function rebootServer(){"
        ~ "const serverId=document.getElementById('serverId').value;"
        ~ "const rebootType=document.getElementById('rebootType').value;"
        ~ "const region=document.getElementById('region').value||'RegionOne';"
        ~ "const h=authHeaders();h['Content-Type']='application/json';"
        ~ "const r=await fetch('/api/v1/server-actions',{method:'POST',headers:h,body:JSON.stringify({action:'reboot',serverId,rebootType,region})});"
        ~ "document.getElementById('action').textContent=JSON.stringify(await r.json(),null,2);"
        ~ "}"
        ~ "loadInventory();"
        ~ "</script>"
        ~ "</body>"
        ~ "</html>";
}
